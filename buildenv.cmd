@ECHO OFF
:: This file is generated by buildenv tool -- see https://buildenv.readthedocs.io/
:: Please do not edit, changes will be lost

:: Detect git path
set "git_path="
for /f "delims=" %%G in ('where git.exe 2^>nul') do if not defined git_path set "git_path=%%~fG"
if not defined git_path (
    >&2 echo Can't find git.exe, unable to wrap to buildenv.sh
    exit /b 1
)

:: Deduce bash path
for %%I in ("%git_path%") do set "git_dir=%%~dpI"
for %%I in ("%git_dir%..") do set "parent_path=%%~fI"
for %%I in ("%parent_path%") do set "parent_name=%%~nxI"
if /i "%parent_name%"=="mingw64" for %%I in ("%parent_path%\..") do set "parent_path=%%~fI"
if /i "%parent_name%"=="ucrt64"  for %%I in ("%parent_path%\..") do set "parent_path=%%~fI"
set "bash_path=%parent_path%\usr\bin\bash.exe"
if not exist "%bash_path%" (
    >&2 echo Can't find bash.exe, unable to wrap to buildenv.sh
    exit /b 1
)

:: Wrap to buildenv.sh
"%bash_path%" ./buildenv.sh %*
